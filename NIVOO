<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NIVOO - Scopri dove andare</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #111;
        }

        header {
            background: #111;
            color: white;
            padding: 25px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 38px;
            letter-spacing: 3px;
        }

        header p {
            margin-top: 8px;
            color: #ccc;
        }

        .container {
            max-width: 700px;
            margin: auto;
            padding: 25px 20px;
        }

        .search {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
        }

        .search input {
            flex: 1;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 12px;
            font-size: 16px;
        }

        .search button {
            padding: 15px 20px;
            border: none;
            border-radius: 12px;
            background: #111;
            color: white;
            font-weight: bold;
        }

        h2 {
            margin-bottom: 15px;
        }

        .categories {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 30px;
        }

        .category {
            background: white;
            border: none;
            border-radius: 15px;
            padding: 22px 10px;
            font-size: 17px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .places {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .place {
            background: white;
            border-radius: 15px;
            padding: 18px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .place h3 {
            margin-bottom: 8px;
        }

        .rating {
            font-weight: bold;
            margin-bottom: 8px;
        }

        .place button {
            margin-top: 12px;
            padding: 10px 15px;
            border: none;
            border-radius: 10px;
            background: #111;
            color: white;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #777;
        }
    </style>
</head>

<body>

<header>
    <h1>NIVOO</h1>
    <p>Scopri dove andare.</p>
</header>

<div class="container">

    <div class="search">
        <input id="cityInput" type="text" placeholder="Cerca una città...">
        <button onclick="searchCity()">Cerca</button>
    </div>

    <h2 id="cityTitle">Cosa cerchi?</h2>

    <div class="categories">
        <button class="category" onclick="showCategory('Ristoranti')">🍕 Ristoranti</button>
        <button class="category" onclick="showCategory('Bar')">☕ Bar</button>
        <button class="category" onclick="showCategory('Pub')">🍺 Pub</button>
        <button class="category" onclick="showCategory('Nightlife')">🪩 Nightlife</button>
    </div>

    <div class="places" id="places"></div>

</div>

<footer>
    NIVOO © 2026
</footer>

<script>

    const places = [
        {
            name: "Locale Demo",
            category: "Ristoranti",
            city: "Alba",
            rating: "4.7",
            price: "€€"
        },
        {
            name: "Bar Demo",
            category: "Bar",
            city: "Alba",
            rating: "4.6",
            price: "€"
        },
        {
            name: "Pub Demo",
            category: "Pub",
            city: "Alba",
            rating: "4.8",
            price: "€€"
        }
    ];

    let currentCity = "";

    function searchCity() {

        const input = document.getElementById("cityInput").value.trim();

        if (input === "") {
            alert("Scrivi una città.");
            return;
        }

        currentCity = input;

        document.getElementById("cityTitle").innerText =
            "📍 " + input;

        document.getElementById("places").innerHTML = "";

    }

    function showCategory(category) {

        if (currentCity === "") {
            alert("Prima cerca una città.");
            return;
        }

        const results = places.filter(place =>
            place.city.toLowerCase() === currentCity.toLowerCase() &&
            place.category === category
        );

        const container = document.getElementById("places");

        container.innerHTML = "";

        if (results.length === 0) {

            container.innerHTML =
                "<p>Ancora nessun locale disponibile in questa categoria.</p>";

            return;
        }

        results.forEach(place => {

            container.innerHTML += `
                <div class="place">

                    <h3>${place.name}</h3>

                    <div class="rating">
                        ⭐ ${place.rating}
                    </div>

                    <p>${place.category} • ${place.city}</p>

                    <p>${place.price}</p>

                    <button onclick="openMaps('${place.name}', '${place.city}')">
                        🗺️ Vedi su Google Maps
                    </button>

                </div>
            `;

        });

    }

    function openMaps(name, city) {

        const query = encodeURIComponent(name + " " + city);

        window.open(
            "https://www.google.com/maps/search/?api=1&query=" + query,
            "_blank"
        );

    }

</script>

</body>
</html>
